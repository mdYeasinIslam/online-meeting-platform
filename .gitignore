# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

/test-results/
/playwright-report/

# Private research samples and generated artifacts (keep source manifests/docs).
/dataset/raw/*
/dataset/exports/*
/dataset/splits/*
/dataset/reports/*
!/dataset/raw/.gitkeep
!/dataset/exports/.gitkeep
!/dataset/splits/.gitkeep
!/dataset/reports/.gitkeep
/dataset/manifests/*.local.json
/bdsl-landmarks-*.json

# Day-5 private derived tensors, checkpoints, exports, synthetic smoke artifacts.
/research/temporal/generated/
