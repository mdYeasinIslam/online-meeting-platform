    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "hand": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "hands"
      ],
      "properties": {
        "timestamp": {
          "type": "number",
          "minimum": 0,
          "maximum": 8000
        },
        "hands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
