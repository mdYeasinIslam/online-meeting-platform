{
  "schemaVersion": 1,
  "preprocessingVersion": "bdsl-temporal-v1",
  "modelVersion": "temporal-baseline-v1",
  "seed": 4105,
  "splitSeed": "day5-v1",
  "splitRatios": [0.7, 0.15, 0.15],
  "sequenceLength": 32,
  "maxInterpolationGapMs": 250,
  "minimumScale": 1e-8,
  "minimumResampledValidFrames": 8,
  "qualityPolicy": "accepted-only",
  "normalization": "shared-sample-geometric",
  "datasetNormalization": "none",
  "augmentation": { "enabled": false, "coordinateJitter": 0.005 },
  "units": 32,
  "denseUnits": 16,
  "dropout": 0.2,
  "learningRate": 0.001,
  "batchSize": 8,
  "epochs": 40,
  "patience": 6,
  "minDelta": 0.0001,
  "selection": "validation-loss",
  "classWeights": false,
  "exportTolerance": 0.0001
}
